#!/usr/bin/env python3
"""FakeSlurm sbatch: ``sbatch --parsable [flags] script``."""

import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _fakeslurm as fs  # noqa: E402

LONG = {
    "--job-name": "name",
    "--partition": "partition",
    "--account": "account",
    "--time": "time_limit",
    "--output": "output",
    "--error": "error",
    "--array": "array",
    "--dependency": "dependency",
}
SHORT = {
    "-J": "name",
    "-p": "partition",
    "-A": "account",
    "-t": "time_limit",
    "-o": "output",
    "-a": "array",
}


def parse_flags(tokens, into):
    """Fill ``into`` from sbatch-style tokens; returns leftover positionals."""
    rest = []
    i = 0
    while i < len(tokens):
        t = tokens[i]
        key = None
        val = None
        if t.startswith("--"):
            name, eq, v = t.partition("=")
            if name in LONG:
                key = LONG[name]
                if eq:
                    val = v
                else:
                    i += 1
                    val = tokens[i] if i < len(tokens) else ""
        elif t.startswith("-") and len(t) >= 2 and t[:2] in SHORT:
            key = SHORT[t[:2]]
            if len(t) > 2:
                val = t[2:]
            else:
                i += 1
                val = tokens[i] if i < len(tokens) else ""
        elif t.startswith("-"):
            pass  # unknown flag: ignore (value-taking unknown flags are not supported)
        else:
            rest.append(t)
        if key is not None:
            into[key] = val
        i += 1
    return rest


def main():
    argv = [a for a in sys.argv[1:] if a != "--parsable"]
    opts = {}
    positional = parse_flags(argv, opts)
    if not positional:
        fs.die("sbatch: error: no script given")
    script = positional[0]
    try:
        with open(script, encoding="utf-8", errors="replace") as f:
            content = f.read()
    except OSError as e:
        fs.die(f"sbatch: error: Unable to open file {script}: {e}")
    if "FAKESLURM_REJECT_TRANSIENT" in content:
        # A transient controller/network error: NOT a policy rejection, so the client must
        # not remember it in learned_notes.txt.
        sys.stderr.write(
            "sbatch: error: Batch job submission failed: "
            "Unable to contact slurm controller (connect failure)\n"
        )
        sys.exit(1)
    if "FAKESLURM_REJECT" in content:
        sys.stderr.write(
            "SBATCH ERROR: \n"
            " Walltime must be at least 15 minutes (except on the debug partition)\n"
            "SBATCH: Job not submitted because of this error.\n"
        )
        sys.exit(64)
    # #SBATCH directives are lower priority than command-line flags.
    directives = {}
    for line in content.splitlines():
        m = re.match(r"^#SBATCH\s+(.*)$", line.strip())
        if m:
            parse_flags(m.group(1).split(), directives)
    directives.update(opts)
    opts = directives

    cwd = os.getcwd()

    def resolve_path(tmpl, base, task=None):
        s = tmpl.replace("%A", str(base)).replace("%j", str(base)).replace("%J", str(base))
        if task is not None:
            s = s.replace("%a", str(task))
        if not os.path.isabs(s):
            s = os.path.join(cwd, s)
        return s

    def base_job(base, name):
        return {
            "id": base,
            "name": name,
            "state": "PENDING",
            "state_raw": "PENDING",
            "submit_time": fs.time.time(),
            "submit_tick": state["tick"],
            "start_time": None,
            "end_time": None,
            "user": fs.user(),
            "partition": opts.get("partition") or "debug",
            "account": opts.get("account") or "rrg-fake",
            "time_limit": opts.get("time_limit") or "00:03:00",
            "workdir": cwd,
            "script": os.path.abspath(script),
            "exit_code": "0:0",
            "nodelist": "",
            "fail": "FAKESLURM_FAIL" in content,
            "outcome": os.environ.get("FAKESLURM_OUTCOME"),
        }

    name = opts.get("name") or os.path.basename(script)
    with fs.locked_state() as state:
        jid = state["next_id"]
        state["next_id"] = jid + 1
        if opts.get("array"):
            tasks, throttle = fs.parse_array_spec(opts["array"])
            out_tmpl = opts.get("output") or "slurm-%A_%a.out"
            err_tmpl = opts.get("error") or ""
            fail_tasks = fs.array_fail_set()
            for t in tasks:
                job = base_job(jid, name)
                job["full_id"] = "%d_%d" % (jid, t)
                job["array_base"] = str(jid)
                job["array_task"] = t
                job["array_throttle"] = throttle
                job["output_tmpl"] = out_tmpl
                job["error_tmpl"] = err_tmpl
                job["stdout"] = resolve_path(out_tmpl, jid, t)
                job["stderr"] = resolve_path(err_tmpl, jid, t) if err_tmpl else ""
                if t in fail_tasks:
                    job["fail"] = True
                    job["outcome"] = None
                state["jobs"][job["full_id"]] = job
        else:
            out = resolve_path(opts.get("output") or "slurm-%j.out", jid)
            err = resolve_path(opts["error"], jid) if opts.get("error") else ""
            job = base_job(jid, name)
            job["stdout"] = out
            job["stderr"] = err
            state["jobs"][str(jid)] = job
    sys.stdout.write(f"{jid}\n")


if __name__ == "__main__":
    main()
