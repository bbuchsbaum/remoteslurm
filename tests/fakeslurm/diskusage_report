#!/usr/bin/env python3
"""FakeSlurm diskusage_report --per_user: prints fixtures/slurm/diskusage.txt."""

import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
FIXTURE = os.path.join(HERE, "..", "fixtures", "slurm", "diskusage.txt")

if __name__ == "__main__":
    with open(FIXTURE, encoding="utf-8") as f:
        sys.stdout.write(f.read())
