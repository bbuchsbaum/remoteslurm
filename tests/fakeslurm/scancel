#!/usr/bin/env python3
"""FakeSlurm scancel: ``scancel <ids...>``."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _fakeslurm as fs  # noqa: E402


def main():
    ids = []
    for a in sys.argv[1:]:
        if not a.startswith("-"):
            ids.extend(fs.lookup_ids(a))
    if not ids:
        fs.die("scancel: error: No job identification provided")
    rc = 0
    with fs.locked_state() as state:
        for jid in ids:
            job = state["jobs"].get(jid)
            if job is None:
                sys.stderr.write(
                    f"scancel: error: Kill job error on job id {jid}: Invalid job id specified\n"
                )
                rc = 1
                continue
            if fs.is_terminal(job):
                continue
            job["state"] = "CANCELLED"
            job["state_raw"] = f"CANCELLED by {os.getuid()}"
            job["exit_code"] = "0:0"
            job["end_time"] = fs.time.time()
            job["end_tick"] = state["tick"]
    sys.exit(rc)


if __name__ == "__main__":
    main()
