#!/usr/bin/env python3
"""FakeSlurm scancel: ``scancel <ids...>``."""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _fakeslurm as fs  # noqa: E402


def main():
    tokens = []
    for a in sys.argv[1:]:
        if not a.startswith("-"):
            tokens.extend(fs.query_tokens(a))
    if not tokens:
        fs.die("scancel: error: No job identification provided")
    rc = 0
    with fs.locked_state() as state:
        matched, missing = fs.match_jobs(state, tokens)  # a base id cancels all its tasks
        for tok in missing:
            sys.stderr.write(
                f"scancel: error: Kill job error on job id {tok}: Invalid job id specified\n"
            )
            rc = 1
        for key in matched:
            job = state["jobs"][key]
            if fs.is_terminal(job):
                continue
            job["state"] = "CANCELLED"
            job["state_raw"] = f"CANCELLED by {os.getuid()}"
            job["exit_code"] = "0:0"
            job["end_time"] = fs.time.time()
            job["end_tick"] = state["tick"]
    sys.exit(rc)


if __name__ == "__main__":
    main()
